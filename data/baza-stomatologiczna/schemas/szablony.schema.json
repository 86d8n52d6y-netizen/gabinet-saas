{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "opis",
  "szablony"
 ],
 "properties": {
  "opis": {
   "type": "string",
   "minLength": 1
  },
  "szablony": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "dotyczy",
     "wariant",
     "tekst",
     "pola"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^SZAB-[A-Z0-9.-]+$"
     },
     "dotyczy": {
      "type": "string",
      "pattern": "^(BAD-[A-Z0-9-]+|PROC-23\\.[0-9]{2,5}[a-z]?)$"
     },
     "wariant": {
      "enum": [
       "standardowy",
       "skrocony",
       "rozszerzony"
      ]
     },
     "tekst": {
      "type": "string",
      "minLength": 1
     },
     "pola": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^POLE-[A-Z0-9-]+$"
      }
     },
     "uwagi": {
      "type": "string",
      "minLength": 1
     },
     "tekst_aplikacji": {
      "type": "string",
      "description": "klucz tekstu w generator/szablony.js lub obiekcie D (generator/nfz.html), jeśli istnieje"
     }
    }
   }
  }
 }
}
