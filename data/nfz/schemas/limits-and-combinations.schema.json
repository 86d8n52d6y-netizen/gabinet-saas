{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nfz/limits-and-combinations.schema.json",
  "title": "limits-and-combinations",
  "type": "object",
  "properties": {
    "stan_na": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "laczenie": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "pattern": "^(DOZWOLONE|NIEDOZWOLONE|WARUNKOWO DOZWOLONE|WYMAGA DODATKOWEJ WERYFIKACJI|NIE DOTYCZY)"
          },
          "regula": {
            "type": "string",
            "pattern": "^R-"
          }
        },
        "required": [
          "a",
          "b",
          "status",
          "regula"
        ],
        "additionalProperties": true
      }
    },
    "limity": {
      "type": "array"
    }
  },
  "required": [
    "stan_na",
    "laczenie",
    "limity",
    "zasada_domyslna"
  ],
  "additionalProperties": true
}
