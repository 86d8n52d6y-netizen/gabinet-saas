{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nfz/diagnoses.schema.json",
  "title": "diagnoses",
  "type": "object",
  "properties": {
    "stan_na": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "diagnozy": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kod": {
            "type": "string",
            "pattern": "^[A-Z]\\d{2}(\\.\\d)?$"
          },
          "nazwa_who_en": {
            "type": "string"
          },
          "nazwa_pl_robocza": {
            "type": "string",
            "minLength": 2
          },
          "status": {
            "enum": [
              "POTWIERDZONA",
              "CZĘŚCIOWO POTWIERDZONA",
              "WYMAGA WERYFIKACJI"
            ]
          },
          "zrodla": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kod",
          "nazwa_pl_robocza",
          "status",
          "zrodla"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "stan_na",
    "diagnozy"
  ],
  "additionalProperties": true
}
