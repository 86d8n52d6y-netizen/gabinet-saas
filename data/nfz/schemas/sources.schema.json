{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nfz/sources.schema.json",
  "title": "sources",
  "type": "object",
  "properties": {
    "stan_na": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "zrodla": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SRC-"
          },
          "typ": {
            "type": "string"
          },
          "tytul": {
            "type": "string",
            "minLength": 5
          },
          "url": {
            "type": "string"
          },
          "obowiazuje_od": {
            "type": "string"
          },
          "stan": {
            "type": "string"
          },
          "uwagi": {
            "type": "string"
          },
          "status": {
            "enum": [
              "POTWIERDZONA",
              "CZĘŚCIOWO POTWIERDZONA",
              "WYMAGA WERYFIKACJI"
            ]
          },
          "data_dostepu": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "typ",
          "tytul",
          "url",
          "obowiazuje_od",
          "status",
          "data_dostepu"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "stan_na",
    "zrodla"
  ],
  "additionalProperties": true
}
