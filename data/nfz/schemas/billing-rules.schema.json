{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nfz/billing-rules.schema.json",
  "title": "billing-rules",
  "type": "object",
  "properties": {
    "stan_na": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reguly": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R-"
          },
          "obszar": {
            "type": "string",
            "minLength": 2
          },
          "warstwa": {
            "type": "string",
            "minLength": 2
          },
          "wyzwalacz": {
            "type": "string",
            "minLength": 3
          },
          "tresc": {
            "type": "string",
            "minLength": 10
          },
          "poziom": {
            "enum": [
              "BLOKADA",
              "OSTRZEŻENIE",
              "INFORMACJA"
            ]
          },
          "status": {
            "enum": [
              "POTWIERDZONA",
              "CZĘŚCIOWO POTWIERDZONA",
              "WYMAGA WERYFIKACJI"
            ]
          },
          "zrodla": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "obowiazuje_od": {
            "type": "string"
          },
          "obowiazuje_do": {
            "type": [
              "string",
              "null"
            ]
          },
          "dotyczy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uwagi": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "obszar",
          "warstwa",
          "wyzwalacz",
          "tresc",
          "poziom",
          "status",
          "zrodla",
          "obowiazuje_od",
          "obowiazuje_do"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "stan_na",
    "reguly"
  ],
  "additionalProperties": true
}
