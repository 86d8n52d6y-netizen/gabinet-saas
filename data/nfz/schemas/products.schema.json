{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nfz/products.schema.json",
  "title": "products",
  "type": "object",
  "properties": {
    "stan_na": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "jednostkowe_zal_1b": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kod_icd9": {
            "type": "string"
          },
          "kod_produktu": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^5\\.13\\.00\\.\\d{7}$"
          },
          "punkty": {
            "type": "integer",
            "minimum": 1
          },
          "kod_produktu_status": {
            "type": "string"
          },
          "zrodlo": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kod_icd9",
          "kod_produktu",
          "punkty",
          "zrodlo"
        ],
        "additionalProperties": true
      }
    },
    "pakiety_zal_1c_1d": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ST\\d{2}[A-G]?$"
          },
          "kod_produktu": {
            "type": "string",
            "pattern": "^5\\.13\\.00\\.7\\d{6}$"
          },
          "punkty": {
            "type": "integer",
            "minimum": 1
          },
          "sklad": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "kod_produktu",
          "punkty",
          "sklad",
          "zakresy",
          "zrodlo"
        ],
        "additionalProperties": true
      }
    },
    "wspolczynniki": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "wartosc": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "wartosc",
          "dotyczy",
          "zrodlo"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "stan_na",
    "jednostkowe_zal_1b",
    "pakiety_zal_1c_1d",
    "wspolczynniki",
    "zakresy"
  ],
  "additionalProperties": true
}
