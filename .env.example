# Skopiuj ten plik jako .env (skrypty uruchom-* robią to same i wpisują losowe wartości).
# Wartości lokalne – nie używaj ich nigdzie indziej. Pliku .env nie wysyłaj do repozytorium.
DB_ADMIN_PASSWORD=zmien-na-losowe-haslo-min-16-znakow
DB_APP_PASSWORD=zmien-na-inne-losowe-haslo-min-16
# 64 znaki szesnastkowe (openssl rand -hex 32):
AUTH_SECRET=wpisz-64-znaki-hex
APP_ENC_KEY=wpisz-64-znaki-hex
